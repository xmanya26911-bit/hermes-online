# ============================================================================
# Hermes Online — environment template (placeholders ONLY, never real keys)
# Copy to .env locally. On Render/Vercel set these in the dashboard instead.
# ============================================================================

# ---- Render backend (server-side ONLY, never NEXT_PUBLIC_*) ----
# Hermes' native OpenCode Zen provider reads this from $HERMES_HOME/.env.
# Get a key at https://opencode.ai/auth
OPENCODE_ZEN_API_KEY=your_key_here
# Optional override (default is already correct):
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1

# Model served through Hermes (Responses API, auto-routed to /responses).
HERMES_MODEL=muse-spark-1.3-contributor-free
HERMES_PROVIDER=opencode-zen

# Shared secret that gates the browser -> Render connection.
# Generate: openssl rand -hex 32   (min 16 chars, 32+ recommended)
HERMES_AUTH_TOKEN=change_me_to_a_long_random_secret

# CORS allowlist, comma-separated. Production must include the Vercel origin.
FRONTEND_ORIGIN=https://hermesonline.vercel.app
# Local dev adds http://localhost:3000 automatically when ENV!=production.

# Hermes runtime
HERMES_HOME=/data/.hermes
HERMES_WORKSPACE=/data/workspace
HERMES_PORT=12719
# Render injects $PORT for the public edge; do not set locally.

# ---- Vercel frontend (public, safe for browser) ----
# Points the browser at the Render service. No secrets here.
NEXT_PUBLIC_HERMES_BACKEND_URL=https://YOUR-RENDER-SERVICE.onrender.com
